{
  "name": "aishub",
  "version": "1.0.6",
  "private": true,
  "description": "Ai'sHub - offline-first AI assistant + agent with 100+ models and auto model discovery",
  "scripts": {
    "build": "node tools/build.mjs",
    "sync": "npm run build && npx cap copy android",
    "serve": "node tools/serve.mjs",
    "test": "npm run build && node --test tests/app.test.mjs",
    "icons": "node tools/make-icons.mjs",
    "android": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sparticuz/chromium": "^153.0.0",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0"
  }
}
