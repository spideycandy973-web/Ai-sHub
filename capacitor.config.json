{
  "appId": "com.aishub",
  "appName": "Ai'sHub",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#07070B",
    "resolveServiceWorkerRequests": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#07070B",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
